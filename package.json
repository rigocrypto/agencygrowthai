    "setup-dist": "node -e \"const fs=require('fs');if(!fs.existsSync('.next'))fs.mkdirSync('.next');['app-build-manifest.json','app-path-routes-manifest.json','build-manifest.json','export-marker.json','images-manifest.json','next-minimal-server.js.nft.json','next-server.js.nft.json','prerender-manifest.js','prerender-manifest.json','react-loadable-manifest.json','required-server-files.json','routes-manifest.json','server','static','cache','types'].forEach(f=>{if(fs.existsSync(f))fs.cpSync(f,'.next/'+f,{recursive:true});});if(fs.existsSync('build_id'))fs.copyFileSync('build_id','.next/BUILD_ID');if(fs.existsSync('.next/required-server-files.json')){const r=JSON.parse(fs.readFileSync('.next/required-server-files.json','utf8'));r.appDir=process.cwd();r.config.experimental.outputFileTracingRoot=process.cwd();fs.writeFileSync('.next/required-server-files.json',JSON.stringify(r));}if(fs.existsSync('.next/static/mzzewogzmm3rrhpcrf4ok')){const d='.next/static/MZZeWoGZmm3rrHPcrF4oK';fs.cpSync('.next/static/mzzewogzmm3rrhpcrf4ok',d,{recursive:true});if(fs.existsSync(d+'/_buildmanifest.js'))fs.copyFileSync(d+'/_buildmanifest.js',d+'/_buildManifest.js');if(fs.existsSync(d+'/_ssgmanifest.js'))fs.copyFileSync(d+'/_ssgmanifest.js',d+'/_ssgManifest.js');}\"",
    "dev": "npm run setup-dist && node standalone/server.js",
