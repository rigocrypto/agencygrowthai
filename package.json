{
  "name": "nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test --workers=1",
    "test:e2e:prod": "next build && playwright test --config=playwright.prod.config.ts --workers=1",
    "test:perf": "next build && playwright test --config=playwright.perf.config.ts --workers=1",
    "test:tenant": "playwright test --config=playwright.tenant.config.ts",
    "test:nhost": "node tests-nhost/phase2b-runtime-security.mjs",
    "test:nhost:guards": "node tests-nhost/boundary-guard.mjs",
    "test:nhost:phase3a": "playwright test --config=playwright.nhost.config.ts",
    "test:nhost:phase3a:guards": "node tests-nhost/phase3a-boundary-guard.mjs",
    "test:nhost:phase3b:guards": "node tests-nhost/phase3b-boundary-guard.mjs",
    "test:nhost:phase3b": "playwright test --config=playwright.nhost.phase3b.config.ts",
    "nhost:phase3c:idempotency": "node tests-nhost/apply-phase3c-idempotency.mjs",
    "test:nhost:phase3c:guards": "node tests-nhost/phase3c-boundary-guard.mjs",
    "test:nhost:secrets": "node tests-nhost/secret-safety.mjs",
    "test:nhost:bundle-secrets": "node tests-nhost/production-bundle-secret-safety.mjs",
    "test:nhost:phase3c": "playwright test --config=playwright.nhost.phase3c.config.ts",
    "test:ops:baseline": "node tests-operations/remote-baseline.mjs",
    "test:ops:observability": "node tests-operations/observability-guard.mjs",
    "test:ops:smoke": "node tests-operations/production-smoke.mjs",
    "test:ops:recovery": "node tests-operations/hasura-recovery-drill.mjs",
    "test:ops:runbooks": "node tests-operations/runbook-guard.mjs",
    "test:ops:credential-artifacts": "node tests-operations/credential-artifact-guard.mjs",
    "test:security:middleware": "node tests-operations/middleware-bypass.mjs",
    "test:e2e:baseline": "npm run build && playwright test --config=playwright.prod.config.ts --workers=1 --reporter=json > .playwright-report.json && node scripts/check-baseline.mjs .playwright-report.json"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
